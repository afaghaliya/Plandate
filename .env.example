# --- Database -------------------------------------------------------------
# Dev default: local SQLite file (zero setup).
# For PostgreSQL: set provider = "postgresql" in prisma/schema.prisma and use
#   DATABASE_URL="postgresql://user:pass@localhost:5432/planadate?schema=public"
DATABASE_URL="file:./dev.db"

# --- Auth (Auth.js / NextAuth v5) ----------------------------------------
AUTH_SECRET="dev-only-secret-change-me-in-production"
AUTH_TRUST_HOST="true"

# --- AI ------------------------------------------------------------------
# Provider: "anthropic" | "mock"  (mock = deterministic offline planner)
AI_PROVIDER="anthropic"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5"

# --- Maps ----------------------------------------------------------------
# Default tiles are OpenStreetMap (no key needed). Swap in src/lib/maps.ts.
NEXT_PUBLIC_MAP_TILE_URL="https://tile.openstreetmap.org/{z}/{x}/{y}.png"
NEXT_PUBLIC_MAP_ATTRIBUTION="&copy; OpenStreetMap contributors"
